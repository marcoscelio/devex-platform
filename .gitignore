__pycache__/
*.pyc
.venv/
.uv/
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.hypothesis/

# CDK
cdk.out/

# OS / editors
.DS_Store
.idea/
.vscode/

# Local audit sink (dev only)
*.dora.jsonl
